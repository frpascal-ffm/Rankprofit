---
const steps = [
  ['01', 'Analyse', 'Wir prüfen Markt, Zielgruppe und bestehende Kanäle.'],
  ['02', 'Konzept', 'Sie erhalten eine priorisierte Roadmap mit messbaren Zielen.'],
  ['03', 'Umsetzung', 'Wir setzen Website, SEO und Kampagnen strukturiert um.'],
  ['04', 'Optimierung', 'Nach Launch verbessern wir kontinuierlich Conversion und Sichtbarkeit.']
];
---
<section id="workflow" class="section-shell">
  <div class="section-container max-w-5xl">
    <span class="section-kicker reveal-up">Prozess</span>
    <h2 class="section-title reveal-up" style="--delay:80ms;">So arbeiten wir zusammen.</h2>
    <ol class="mt-12 space-y-6 workflow-list">
      {steps.map(([nr, title, text], index) => (
        <li class="card workflow-item reveal-up" style={`--delay:${index * 100}ms;`}>
          <p class="text-emerald-400 text-sm font-semibold">Schritt {nr}</p>
          <h3 class="text-2xl font-display font-semibold text-white mt-2">{title}</h3>
          <p class="text-slate-400 mt-3">{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
