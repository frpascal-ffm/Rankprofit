---
const benefits = [
  ['Messbare Ergebnisse', 'Jede Maßnahme wird mit klaren Metriken bewertet: Leads, Umsatz und ROAS.'],
  ['Premium Qualität', 'Hochwertiges Design und technische Exzellenz für einen starken Markenauftritt.'],
  ['Volle Transparenz', 'Regelmäßige Reportings, offene Kommunikation und nachvollziehbare Entscheidungen.'],
  ['Persönliche Betreuung', 'Direkter Kontakt mit Expert:innen statt wechselnder Ansprechpartner.']
];
---
<section id="benefits" class="section-shell">
  <div class="section-container">
    <span class="section-kicker reveal-up">Ihre Vorteile</span>
    <h2 class="section-title reveal-up" style="--delay:80ms;">Ihr Wachstum ist unser Antrieb.</h2>
    <p class="text-slate-400 mt-5 max-w-2xl text-lg reveal-up" style="--delay:140ms;">Wir verbinden datengetriebenes Marketing mit klaren Prozessen und starken digitalen Produkten.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      {benefits.map(([title, description], index) => (
        <article class="card benefit-card reveal-up" style={`--delay:${index * 90}ms;`}>
          <span class="benefit-dot" aria-hidden="true"></span>
          <h3 class="text-xl font-display font-semibold text-white">{title}</h3>
          <p class="text-slate-400 mt-3 leading-relaxed">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
