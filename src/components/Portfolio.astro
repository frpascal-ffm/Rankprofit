---
const projects = [
  {
    title: 'BT Ihr Objektbetreuer',
    category: 'Objektbetreuung & Hausmeisterservice',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=1200&auto=format&fit=crop',
    link: 'https://www.bt-ihrobjektbetreuer.de/'
  },
  {
    title: 'Fahrdienst Richter',
    category: 'Personenbeförderung & Shuttle',
    image: 'https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?q=80&w=1200&auto=format&fit=crop',
    link: 'https://fahrdienst-richter.de/'
  },
  {
    title: 'Mietfleet',
    category: 'Fahrzeugvermietung',
    image: 'https://images.unsplash.com/photo-1560958089-b8a1929cea89?q=80&w=1200&auto=format&fit=crop',
    link: 'https://mietfleet.de/'
  }
];
---
<section id="portfolio" class="section-shell">
  <div class="section-container">
    <span class="section-kicker">Referenzen</span>
    <h2 class="section-title">Ausgewählte Kundenprojekte.</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
      {projects.map((project) => (
        <article class="card overflow-hidden p-0">
          <img src={project.image} alt={`Screenshot von ${project.title}`} loading="lazy" class="w-full aspect-[4/3] object-cover" referrerpolicy="no-referrer" />
          <div class="p-6">
            <h3 class="text-xl font-display font-semibold text-white">{project.title}</h3>
            <p class="text-slate-400 mt-2">{project.category}</p>
            <a class="inline-flex mt-4 text-emerald-400 font-medium hover:text-emerald-300" href={project.link} target="_blank" rel="noopener noreferrer">Website besuchen →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
