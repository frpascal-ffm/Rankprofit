---
const services = [
  ['Webdesign', 'Conversion-optimierte Webseiten und Landingpages mit Fokus auf Geschwindigkeit und Lead-Generierung.'],
  ['SEO & Sichtbarkeit', 'Technisches SEO, Content-Strukturen und lokale Sichtbarkeit für nachhaltigen organischen Traffic.'],
  ['Google Ads & SEA', 'Performance-Kampagnen mit sauberem Tracking, klarer Attribution und laufender Optimierung.'],
  ['KI-Automatisierung', 'Automatisierte Workflows für Marketing, Vertrieb und Kundenkommunikation.'],
  ['Webanwendungen', 'Skalierbare Plattformen und interne Tools für digitale Prozesse.'],
  ['Mobile Apps', 'UX-starke mobile Lösungen für iOS und Android.']
];
---
<section id="services" class="section-shell">
  <div class="section-container">
    <span class="section-kicker reveal-up">Leistungen</span>
    <h2 class="section-title reveal-up" style="--delay:80ms;">Digitale Lösungen aus einer Hand.</h2>
    <p class="text-slate-400 mt-5 max-w-3xl text-lg reveal-up" style="--delay:140ms;">Von der Strategie bis zur Umsetzung liefern wir messbare Ergebnisse für Marketing und Website-Performance.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      {services.map(([title, description], index) => (
        <article class="card h-full service-card reveal-up" style={`--delay:${index * 80}ms;`}>
          <div class="service-orb" aria-hidden="true"></div>
          <h3 class="text-2xl text-white font-display font-semibold">{title}</h3>
          <p class="text-slate-400 mt-4 leading-relaxed">{description}</p>
          <p class="mt-6 text-emerald-400 font-medium service-link">Mehr erfahren →</p>
        </article>
      ))}
    </div>
  </div>
</section>
