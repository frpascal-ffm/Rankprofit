<form class="card mt-10" method="post" action="#">
  <h2 class="text-3xl font-display font-bold text-white">Projektanfrage</h2>
  <p class="text-slate-400 mt-3">Je präziser Ihre Angaben sind, desto besser können wir Ihr Projekt einschätzen.</p>

  <fieldset class="mt-8 grid gap-5 md:grid-cols-2">
    <label class="flex flex-col gap-2 text-slate-200">
      Name *
      <input required name="name" autocomplete="name" class="bg-slate-950 border border-slate-800 rounded-xl px-4 py-3" />
    </label>
    <label class="flex flex-col gap-2 text-slate-200">
      E-Mail *
      <input required type="email" name="email" autocomplete="email" class="bg-slate-950 border border-slate-800 rounded-xl px-4 py-3" />
    </label>
    <label class="flex flex-col gap-2 text-slate-200">
      Telefon
      <input type="tel" name="phone" autocomplete="tel" class="bg-slate-950 border border-slate-800 rounded-xl px-4 py-3" />
    </label>
    <label class="flex flex-col gap-2 text-slate-200">
      Budgetrahmen
      <select name="budget" class="bg-slate-950 border border-slate-800 rounded-xl px-4 py-3">
        <option value="">Bitte wählen</option>
        <option>Unter 1.000 €</option>
        <option>1.000–2.500 €</option>
        <option>2.500–5.000 €</option>
        <option>5.000 €+</option>
      </select>
    </label>
    <label class="md:col-span-2 flex flex-col gap-2 text-slate-200">
      Ziel / Nachricht
      <textarea name="message" rows="6" class="bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 resize-y" placeholder="Was möchten Sie mit Ihrer Website oder Kampagne erreichen?"></textarea>
    </label>
  </fieldset>

  <button class="mt-8 px-8 py-4 rounded-full bg-emerald-500 text-slate-950 font-bold hover:bg-emerald-400">Unverbindlich anfragen</button>
</form>
